# --- OpenAI ---
# AZURE_OPENAI_ENDPOINT を設定しない場合は OpenAI を使用します。
OPENAI_API_KEY=replace_with_your_key

# --- Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT を設定すると Azure OpenAI を使用します（OPENAI_API_KEY は無視されます）。
# AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
# AZURE_OPENAI_API_KEY=replace_with_your_azure_key

# --- 共通 ---
# OpenAI の場合はモデル名、Azure OpenAI の場合はデプロイ名を指定します。
# 設定例（会話 1 分あたりのおおよそのコスト。ユーザー発話 約50% / モデル発話 約50% と仮定）:
#   gpt-realtime-2.1       約 $0.05〜0.10/分（約 8〜16 円/分）    （音声: 入力 $32 / 出力 $64 per 100万トークン）
#   gpt-realtime-2.1-mini  約 $0.015〜0.03/分（約 2.4〜4.8 円/分） （音声: 入力 $10 / 出力 $20 per 100万トークン）
# 円換算は 1 ドル = 160 円で計算しています。
# あくまで目安です。テキスト/推論トークンやコンテキスト長により実際のコストは変動します。
# Azure の料金は異なる場合があります。公式の料金ページを確認してください。
REALTIME_MODEL=gpt-realtime
# 画面の料金表示に使うモデル名。Azure のデプロイ名がモデル名と異なる場合に設定します
# （例: REALTIME_PRICING_MODEL=gpt-realtime-2.1-mini）。
# REALTIME_PRICING_MODEL=
PORT=3000

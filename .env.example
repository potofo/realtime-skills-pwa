# --- OpenAI ---
# OpenAI is used when AZURE_OPENAI_ENDPOINT is not set.
OPENAI_API_KEY=replace_with_your_key

# --- Azure OpenAI ---
# Setting AZURE_OPENAI_ENDPOINT switches to Azure OpenAI (OPENAI_API_KEY is ignored).
# AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
# AZURE_OPENAI_API_KEY=replace_with_your_azure_key

# --- Common ---
# Model name for OpenAI, or deployment name for Azure OpenAI.
# Examples (approximate cost per minute of conversation, assuming ~50% user speech / ~50% model speech):
#   gpt-realtime-2.1       ~ $0.05-0.10/min (~JPY 8-16/min)    (audio: $32 in / $64 out per 1M tokens)
#   gpt-realtime-2.1-mini  ~ $0.015-0.03/min (~JPY 2.4-4.8/min) (audio: $10 in / $20 out per 1M tokens)
# JPY figures assume USD 1 = JPY 160.
# Estimates only; actual cost varies with text/reasoning tokens and context length.
# Azure pricing may differ. Check the official pricing pages.
REALTIME_MODEL=gpt-realtime
# Model name used for the on-screen cost estimate. Set this when the Azure deployment name
# differs from the model name (e.g. REALTIME_PRICING_MODEL=gpt-realtime-2.1-mini).
# REALTIME_PRICING_MODEL=
PORT=3000
